// Prisma Schema for CareCircle - Multi-Patient Caregiver Coordination Dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Caregiver {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patients     Patient[]
  alerts       Alert[]
}

model Patient {
  id               String    @id @default(uuid())
  caregiverId      String
  caregiver        Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  name             String
  dob              DateTime
  gender           String?
  relationship     String
  primaryCondition String?
  bloodType        String?
  allergies        String?
  emergencyContact String?
  notes            String?
  avatarColor      String    @default("#0D9488")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  medications      Medication[]
  medicationLogs   MedicationLog[]
  symptomLogs      SymptomLog[]
  appointments     Appointment[]
  alerts           Alert[]
}

model Medication {
  id                String          @id @default(uuid())
  patientId         String
  patient           Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name              String
  dosage            String
  frequency         String
  timesOfDay        String          // JSON array string e.g. ["08:00", "20:00"]
  instructions      String?
  prescribingDoctor String?
  totalQuantity     Int             @default(30)
  remainingQuantity Int             @default(30)
  refillThreshold   Int             @default(7)
  nextRefillDate    DateTime?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  logs              MedicationLog[]
}

model MedicationLog {
  id           String     @id @default(uuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  status       String     // "TAKEN" | "MISSED" | "SKIPPED"
  takenAt      DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
}

model SymptomLog {
  id                     String   @id @default(uuid())
  patientId              String
  patient                Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  timestamp              DateTime @default(now())
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  bloodSugar             Float?
  heartRate              Int?
  weight                 Float?
  temperature            Float?
  mood                   String?
  symptomSeverity        Int?     // 1 to 10 scale
  notes                  String?
  createdAt              DateTime @default(now())
}

model Appointment {
  id             String          @id @default(uuid())
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorName     String
  specialty      String?
  location       String?
  dateTime       DateTime
  reason         String?
  notes          String?
  status         String          @default("UPCOMING") // "UPCOMING" | "COMPLETED" | "CANCELLED"
  createdAt      DateTime        @default(now())
  
  checklistItems ChecklistItem[]
}

model ChecklistItem {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  task          String
  isCompleted   Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model Alert {
  id          String     @id @default(uuid())
  caregiverId String
  caregiver   Caregiver  @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  patientId   String?
  patient     Patient?   @relation(fields: [patientId], references: [id], onDelete: SetNull)
  type        String     // "MISSED_MED", "REFILL_DUE", "UPCOMING_APPOINTMENT", "VITALS_WARNING"
  title       String
  message     String
  severity    String     @default("warning") // "info", "warning", "danger"
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())
}
